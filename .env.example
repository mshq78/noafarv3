# Base URL of the backend API (leave empty when using mocks)
VITE_API_BASE_URL=http://localhost:4000/api

# Set to 'true' to use the built-in Persian mock data layer with realistic network delays
VITE_USE_MOCKS=true

# Base URL for self-hosted Excalidraw digital canvas provider
VITE_CANVAS_BASE_URL=https://excalidraw.com
