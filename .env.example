# ==========================================================================
# NOAFAR — environment configuration
# Copy to `.env` for local development; on Runflare set these as the
# service's environment variables.
# ==========================================================================

# --- Runtime -------------------------------------------------------------
NODE_ENV=production
PORT=4000
HOST=0.0.0.0

# Behind Runflare's proxy this must stay on: it makes the secure-cookie flag
# and the client IP used for rate limiting correct.
TRUST_PROXY=true

# --- Database (required) -------------------------------------------------
# Connection string for the PostgreSQL instance.
DATABASE_URL=postgresql://user:password@host:5432/noafar
# Set to true when the provider requires TLS (most managed Postgres do).
DATABASE_SSL=true
DATABASE_POOL_MAX=10

# --- Sessions (required in production) -----------------------------------
# At least 32 characters. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=
SESSION_COOKIE_NAME=noafar_session
SESSION_TTL_DAYS=30

# --- Admin bootstrap -----------------------------------------------------
# Comma-separated identifiers promoted to `admin` when they sign in. Set one of
# these to create the first administrator, sign in once, then clear it and
# manage roles from the admin panel.
# Equivalent SQL, if you would rather not restart the service:
#   UPDATE users SET role='admin' WHERE lower(email)='you@example.com';
BOOTSTRAP_ADMIN_PHONES=
BOOTSTRAP_ADMIN_EMAILS=

# --- One-time password (login) ------------------------------------------
OTP_TTL_SECONDS=120
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=60
# Development only: returns the OTP in the API response. Ignored in production.
OTP_DEBUG_RETURN=false

# --- SMS provider --------------------------------------------------------
# console  → prints the code to the server log (default; usable before an SMS
#            contract is in place — read it from the Runflare logs)
# kavenegar→ SMS_API_KEY required; SMS_TEMPLATE for the verify-lookup endpoint
# smsir    → SMS_API_KEY and SMS_TEMPLATE (numeric template id) required
SMS_PROVIDER=console
SMS_API_KEY=
SMS_SENDER=
SMS_TEMPLATE=

# --- Email + password sign-in -------------------------------------------
# Failed sign-in attempts allowed per address per 15 minutes.
LOGIN_MAX_ATTEMPTS=10
# How long a password-reset link stays valid.
PASSWORD_RESET_TTL_MINUTES=60

# Absolute site URL, used to build the reset link inside the email. Falls back
# to the request's own host when empty.
PUBLIC_URL=https://noafar.ir

# SMTP for password-reset mail. With no SMTP_HOST the message is printed to
# the server log instead, so the flow works before a mail contract is set up.
SMTP_HOST=
SMTP_PORT=587
# Leave empty to infer: implicit TLS on port 465, STARTTLS elsewhere.
SMTP_SECURE=
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM="noafar <no-reply@noafar.ir>"

# --- Uploads -------------------------------------------------------------
# Point this at a mounted volume so uploaded files survive redeploys.
UPLOAD_DIR=uploads
UPLOAD_MAX_BYTES=8388608
# Set to false where the filesystem is wiped between deploys (serverless), so
# uploads are refused with a clear message instead of silently disappearing.
# Defaults to false automatically on Vercel/Lambda.
UPLOADS_PERSISTENT=true

# --- Static files --------------------------------------------------------
# Directory holding the built SPA; the server serves it and handles SPA routing.
PUBLIC_DIR=dist

# --- Optional ------------------------------------------------------------
# Extra origins allowed to call the API. Leave empty when the SPA is served
# from this same service (the normal setup).
CORS_ORIGINS=
# Load the sample catalogue on first boot if the database is empty.
SEED_ON_BOOT=false

# --- Frontend build-time -------------------------------------------------
# Leave empty to call the API on the same origin (recommended for production).
# For local Vite dev, point it at the backend server:
# VITE_API_BASE_URL=http://localhost:4000/api
VITE_API_BASE_URL=
