    "dotenv": "^17.2.3",
    "esbuild": "^0.25.0",
    "express": "^4.21.2",
    "framer-motion": "^13.1.1",
    "helmet": "^8.3.0",
    "jalaliday": "^3.1.1",
    "jsonwebtoken": "^9.0.3",
