rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isOperator() {
      return request.auth != null && (get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role in ['operator', 'admin']);
    }

    match /users/{userId} {
      allow read, update: if request.auth != null && (request.auth.uid == userId || isOperator());
      allow create: if request.auth != null && request.auth.uid == userId;
      allow delete: if isOperator();
    }
    
    match /content/{contentId} {
      allow read: if true;
      allow create, update, delete: if isOperator();
    }
    
    match /submissions/{subId} {
      allow read, update: if request.auth != null && (request.auth.uid == resource.data.submitterId || isOperator());
      allow create: if request.auth != null;
      allow delete: if isOperator();
    }
    
    match /comments/{commentId} {
      allow read: if resource.data.status == 'approved' || (request.auth != null && (request.auth.uid == resource.data.authorId || isOperator()));
      allow create: if request.auth != null && request.auth.uid == request.resource.data.authorId;
      allow update, delete: if isOperator();
    }
    
    match /contact_messages/{msgId} {
      allow read, update, delete: if isOperator();
      allow create: if true;
    }
    
    match /event_registrations/{regId} {
      allow read: if request.auth != null && (request.auth.uid == resource.data.userId || isOperator());
      allow create: if request.auth != null && request.auth.uid == request.resource.data.userId;
      allow update, delete: if isOperator();
    }
    
    match /saved_canvases/{canvasId} {
      allow read, update, delete: if request.auth != null && request.auth.uid == resource.data.userId;
      allow create: if request.auth != null && request.auth.uid == request.resource.data.userId;
    }
    
    match /point_transactions/{ptId} {
      allow read: if request.auth != null && (request.auth.uid == resource.data.userId || isOperator());
      allow create, update, delete: if isOperator();
    }
    
    match /bookmarks/{bmId} {
      allow read, delete: if request.auth != null && request.auth.uid == resource.data.userId;
      allow create: if request.auth != null && request.auth.uid == request.resource.data.userId;
      allow update: if false;
    }
    
    match /likes/{likeId} {
      allow read, delete: if request.auth != null && request.auth.uid == resource.data.userId;
      allow create: if request.auth != null && request.auth.uid == request.resource.data.userId;
      allow update: if false;
    }
  }
}
