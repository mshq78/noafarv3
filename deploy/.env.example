# Copy to deploy/.env (setup.sh does this for you and fills the secrets).
# Never commit deploy/.env.

# Domain Caddy serves. Use ":80" to test over the server IP before DNS moves.
DOMAIN=noafar.ir, www.noafar.ir
PUBLIC_URL=https://noafar.ir

POSTGRES_PASSWORD=change-me
SESSION_SECRET=change-me-to-64-random-hex-characters

NODE_ENV=production
TRUST_PROXY=true
DATABASE_SSL=false
UPLOAD_DIR=/app/uploads
UPLOADS_PERSISTENT=true

# Comma-separated; these accounts become admins when they sign in.
BOOTSTRAP_ADMIN_EMAILS=

# Login codes are printed to the server log until an SMS provider is set.
SMS_PROVIDER=console
